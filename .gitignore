condaenv.l8rr463d.requirements.txt

# annotation data (audio, extracted intermediates, local scratch). Raw
# annotation files under 01_annotate/<effort>/annotations/ ARE tracked now, so
# code and annotations move together on one pull — except efforts with their
# own data repo (see 01_annotate/data_sources.json).
01_annotate/.deprecated/
01_annotate/**/audio*/
01_annotate/**/data/
01_annotate/**/local/
01_annotate/**/seenote/
01_annotate/Even Sample/annotations/

# generated outputs. Rebuilt on every run — medium's from the (now tracked)
# raw annotations, the other sets' from a built medium — and they churn each
# time. The build.R / step scripts and translations/ are the tracked record.
01_annotate/**/annotations_combined.csv
01_annotate/**/folds.csv
01_annotate/**/summary*.csv
02_set/sets/*/annotations.csv
02_set/sets/*/folds.csv
02_set/sets/*/summary*.csv

# model artifacts
*.keras
*.pickle
*.pb
*.h5
variables/
models/*/tests/

# data artifacts (audio, embeddings)
data/
audio/
embeddings/

# public-release bundles of annotation efforts — bulk copies distributed
# outside git, gigabytes each
01_annotate/*Public/
01_annotate/*Public.zip

# local execution scratch dirs
.local*/
02_set/sets/.archive

# claude code local settings
.claude/

# per-machine paths (buzzdetect export dest, external audio drives, ...);
# see paths.local.example.json for the shape
paths.local.json
# Diagnostic scripts and artifacts: on disk for posterity, not versioned.
# The README.md write-ups ARE versioned, so a tracked file may cite one.
# Changed 2026-09-11: the rule was "nothing tracked may cite these paths", and
# it had already been broken -- IDEAS.md cites 2026-09-09_jet_1_95/README.md as
# the E3 evidence for its top-ranked idea, and that file was untracked, i.e. one
# `git clean` from the evaporation CLAUDE.md describes. Versioning the prose is
# the cheaper fix than policing the citations.
# Diagnostics: keep the write-ups, drop the artifacts. A gitignored diagnostic is
# a citation waiting to break -- IDEAS.md cites 2026-09-09_jet_1_95 as the E3
# evidence for its top-ranked idea, and that file was untracked until 2026-09-11.
diagnostics/**
!diagnostics/**/
!diagnostics/**/*.md
